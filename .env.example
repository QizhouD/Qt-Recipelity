# Copy to .env. Never commit real secrets.
# ── Database ──────────────────────────────────────────────────────────────────
# MySQL (production / Docker) — default
DATABASE_URL=mysql+asyncmy://recipelity:password@localhost:3306/recipelity?charset=utf8mb4
# SQLite (local dev / test) — uncomment to use:
# DATABASE_URL=sqlite+aiosqlite:///./data/recipes.db
# Set to true to auto-create tables on startup (local dev only; production uses Alembic)
AUTO_CREATE_TABLES=false

# ── MySQL credentials (for docker compose) ────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=password
# Host port for IDE/database tools; containers continue to use mysql:3306.
MYSQL_HOST_PORT=3307

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Media storage ─────────────────────────────────────────────────────────────
# Uploaded images are saved here and served under /media/
MEDIA_ROOT=data/uploads
# Legacy AI-generated media directory
GENERATED_MEDIA_DIR=data/generated
# Max upload size (default 5 MB)
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=16777216

# ── Generative AI (optional; never commit the API key) ────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_VISION_MODEL=gpt-5.6-luna
AI_IMAGE_MODEL=gpt-image-2
AI_REQUEST_TIMEOUT=90
